<!DOCTYPE html>
<html lang="zh-CN">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>直播员更新完成</title>
    <style>
        :root {
            --primary-bg-color: #f4f4f9;
            --secondary-bg-color: #ffffff;
            --text-color: #333;
            --subtext-color: #666;
            --box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
            --border-radius: 12px;
            --font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            background-color: var(--primary-bg-color);
            font-family: var(--font-family);
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            margin: 0;
        }

        .container {
            background-color: var(--secondary-bg-color);
            border-radius: var(--border-radius);
            box-shadow: var(--box-shadow);
            padding: 40px;
            width: 90%;
            max-width: 600px;
            text-align: center;
            animation: fadeIn 0.5s ease-in-out;
        }

        @keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(-20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        h1 {
            font-size: 2.5rem;
            color: var(--text-color);
            margin-bottom: 20px;
            background: url('data:image/png;base64,iVBORw0KGgo...') no-repeat center top;
            background-size: 180px;
            padding-top: 220px;
        }

        p {
            font-size: 1.3rem;
            color: var(--subtext-color);
            line-height: 1.8;
            margin-bottom: 20px;
        }

        .error {
            color: red;
            font-size: 1.1rem;
            margin-top: 15px;
        }

        @media (max-width: 480px) {
            h1 {
                font-size: 2.2rem;
                background-size: 160px;
                padding-top: 200px;
            }

            p {
                font-size: 1.2rem;
            }

            .container {
                padding: 30px;
            }
        }
    </style>
</head>

<body>
    <div class="container">
        <h1>直播员更新完成</h1>
        <p id="update-info"></p>
        <p id="error-message" class="error"></p>
    </div>
    <script>
        async function fetchReadme() {
            try {
                const response = await fetch('https://live-iptv.gohkh7.eu.org/README.md');
                if (!response.ok) {
                    throw new Error(`网络请求失败，状态码：${response.status}`);
                }
                const data = await response.text();
                const dateRegex = /(\d{4}\.\d{2}\.\d{2} \d{2}:\d{2}:\d{2})/;
                const match = dateRegex.exec(data);
                const formattedDate = match
                   ? match[1].replace(/\./g, '年').replace(/ /, '月') + '日'
                    : '未知时间';
                const updateInfoElement = document.getElementById('update-info');
                updateInfoElement.textContent = `直播员已更新，最后更新时间：${formattedDate}`;
            } catch (error) {
                console.error('读取README.md文件时出现错误:', error);
                const errorMessageElement = document.getElementById('error-message');
                errorMessageElement.textContent = `抱歉，获取更新时间时出现问题：${error.message}`;
                const updateInfoElement = document.getElementById('update-info');
                updateInfoElement.textContent = '直播员已更新，最后更新时间：2025年3月25日';
            }
        }

        fetchReadme();
    </script>
</body>

</html>    
