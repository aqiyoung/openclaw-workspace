#!/usr/bin/env python3
"""OpenClaw 综合安全审计脚本
功能：安全检查 + 配置监控 + 通道状态 + 版本漏洞检查
"""
import json, os, subprocess, hashlib, datetime

OPENCLAW_DIR = os.path.expanduser("~/.openclaw")
AUDIT_DIR = os.path.join(OPENCLAW_DIR, "audit")
os.makedirs(AUDIT_DIR, exist_ok=True)

issues = []
warnings = []
info_items = []

def run(cmd):
    try:
        r = subprocess.run(cmd, shell=True, capture_output=True, text=True, timeout=15)
        return r.stdout.strip()
    except:
        return ""

def check(name, cond, msg_ok, msg_bad, level="issue"):
    if cond:
        info_items.append(f"{name}: {msg_ok}")
        print(f"  ✅ {name}: {msg_ok}")
    else:
        if level == "issue":
            issues.append(f"{name}: {msg_bad}")
            print(f"  ❌ {name}: {msg_bad}")
        else:
            warnings.append(f"{name}: {msg_bad}")
            print(f"  ⚠️  {name}: {msg_bad}")

print("===== OpenClaw 安全审计 =====")
print(f"时间: {datetime.datetime.now().strftime('%Y-%m-%d %H:%M:%S')}")
print()

# ===== 1. 安全配置检查 =====
print("[1/4] 安全配置检查...")
creds_path = os.path.join(OPENCLAW_DIR, "credentials")
if os.path.exists(creds_path):
    perm = oct(os.stat(creds_path).st_mode)[-3:]
    check("凭证目录权限", perm == "700", perm, f"{perm} (应为700)")

try:
    cfg = json.load(open(os.path.join(OPENCLAW_DIR, "openclaw.json")))
    bind = cfg.get("gateway", {}).get("bind", "unknown")
    check("Gateway绑定", bind == "loopback", bind, f"{bind} (应为loopback)")
except:
    warnings.append("无法读取配置文件")

# ===== 2. 配置变更检测 =====
print("\n[2/4] 配置变更检测...")
cfg_path = os.path.join(OPENCLAW_DIR, "openclaw.json")
last_hash_file = os.path.join(AUDIT_DIR, "last_config_hash.txt")

if os.path.exists(cfg_path):
    with open(cfg_path, "rb") as f:
        current_hash = hashlib.sha256(f.read()).hexdigest()
    
    if os.path.exists(last_hash_file):
        with open(last_hash_file) as f:
            last_hash = f.read().strip()
        if current_hash != last_hash:
            warnings.append(f"配置文件已变更! 上次:{last_hash[:12]}... 当前:{current_hash[:12]}...")
            print(f"  ⚠️  配置文件已变更")
        else:
            info_items.append("配置文件未变更")
            print(f"  ✅ 配置文件未变更")
    else:
        info_items.append("首次记录配置哈希")
        print(f"  ℹ️  首次记录配置哈希")
    
    with open(last_hash_file, "w") as f:
        f.write(current_hash)

# ===== 3. 通道状态审计 =====
print("\n[3/4] 通道状态审计...")
status_out = run("openclaw status 2>&1")
for ch in ["openclaw-weixin", "feishu", "telegram"]:
    if ch in status_out:
        if "ON" in status_out and "OK" in status_out:
            info_items.append(f"{ch}: 在线正常")
            print(f"  ✅ {ch}: 在线正常")
        else:
            warnings.append(f"{ch}: 状态异常")
            print(f"  ⚠️  {ch}: 状态异常")
    else:
        info_items.append(f"{ch}: 未启用")
        print(f"  ➖ {ch}: 未启用")

# 最近日志错误数
log_file = f"/tmp/openclaw/openclaw-{datetime.date.today().isoformat()}.log"
if os.path.exists(log_file):
    with open(log_file) as f:
        lines = f.readlines()[-500:]
    error_count = sum(1 for l in lines if any(k in l.lower() for k in ["error", "fail", "reject", "denied"]))
    level = "issue" if error_count > 20 else "warning" if error_count > 10 else "ok"
    check("日志错误数", error_count <= 10, str(error_count), f"{error_count} (过多)", "warning")

# ===== 4. 版本与漏洞检查 =====
print("\n[4/4] 版本与漏洞检查...")
ver = run("openclaw --version 2>&1")
print(f"  当前版本: {ver}")
info_items.append(f"当前版本: {ver}")

update_out = run("openclaw update status 2>&1")
if "available" in update_out.lower():
    warnings.append("有新版本可用")
    print("  ⚠️  有新版本可用")
else:
    info_items.append("已是最新版本")
    print("  ✅ 已是最新版本")

# ===== 生成报告 =====
print(f"\n===== 审计完成 =====")
print(f"发现: {len(issues)} 个问题, {len(warnings)} 个警告")

report = {
    "timestamp": datetime.datetime.now().isoformat(),
    "version": ver,
    "issues": issues,
    "warnings": warnings,
    "info": info_items,
    "issue_count": len(issues),
    "warning_count": len(warnings)
}

report_file = os.path.join(AUDIT_DIR, f"audit_{datetime.datetime.now().strftime('%Y%m%d_%H%M%S')}.json")
with open(report_file, "w") as f:
    json.dump(report, f, indent=2, ensure_ascii=False)
print(f"报告已保存: {report_file}")

if issues:
    print("\n🚨 需要通知老板的问题:")
    for i in issues:
        print(f"  - {i}")
