#!/usr/bin/env python3
"""
飞牛 NAS 事件监听器 - 推送到 Telegram
监听数据库事件 + nginx 访问日志(手机 App 登录等)
稳定版 - 增强错误处理和稳定性
"""

import sqlite3
import time
import json
import os
import sys
import logging
import re
from pathlib import Path
from datetime import datetime, timezone, timedelta
import traceback

# 配置
DB_PATH = "/usr/trim/var/eventlogger_service/logger_data.db3"
NGINX_LOG = "/usr/trim/nginx/logs/access.log"
CURSOR_DIR = "/vol1/1000/FNMessageBots/data/cursor"
TELEGRAM_BOT_TOKEN = "8697554205:AAEcZTEujwIW-baszmhiqRTXFqbOtP3LRsg"
TELEGRAM_CHAT_ID = "460212872"
SLEEP_INTERVAL = 5  # 每 5 秒检查一次
MAX_RETRIES = 3
RETRY_DELAY = 2

# SSH 登录记录文件（用于去重）
SSH_LOG_FILE = CURSOR_DIR + "/last_ssh_journal_cursor.txt"

# 事件 ID 映射
EVENT_NAME_MAP = {
    "LoginSucc": "✅ 登录成功",
    "LoginFail": "❌ 登录失败",
    "CopyFile": "📁 文件复制",
    "DeleteFile": "🗑️ 文件删除",
    "EjectDisk": "💿 弹出磁盘",
    "InsertDisk": "💿 插入磁盘",
    "FoundDisk": "💿 发现磁盘",
    "MountStorage": "📂 挂载存储",
    "FW_ENABLE": "🔒 防火墙启用",
    "UPS_CONNET_OL": "🔌 UPS 在线",
    "UPS_ENABLE": "🔌 UPS 启用",
    "CPU_USAGE_ALARM": "⚠️ CPU 使用率告警",
    "CPU_USAGE_RESTORED": "✅ CPU 使用率恢复",
    "MEMORY_USAGE_ALARM": "⚠️ 内存使用率告警",
    "MEMORY_USAGE_RESTORED": "✅ 内存使用率恢复",
    "APP_CRASH": "❌ 应用崩溃",
    "APP_STARTED": "▶️ 应用启动",
    "APP_STOPPED": "⏹️ 应用停止",
    "DISK_IO_ERR": "❌ 磁盘 I/O 错误",
    "StorageBroken": "❌ 存储损坏",
}

# nginx 日志中需要监控的接口(手机 App 登录等)
NGINX_MONITOR_PATTERNS = [
    {
        "pattern": r"POST /v1/accountapi/check",
        "name": "✅ App 登录",
        "ua_pattern": r"com\.trim\.app",  # 手机 App
    },
]

# 配置日志
logging.basicConfig(
    level=logging.INFO,
    format='%(asctime)s - %(name)s - %(levelname)s - %(message)s',
    handlers=[
        logging.FileHandler(f"{CURSOR_DIR}/monitor.log"),
        logging.StreamHandler()
    ]
)
logger = logging.getLogger(__name__)

def init_cursor():
    """初始化 cursor 目录"""
    try:
        os.makedirs(CURSOR_DIR, exist_ok=True)
        return f"{CURSOR_DIR}/last_event_id.txt", f"{CURSOR_DIR}/last_nginx_offset.txt"
    except Exception as e:
        logger.error(f"创建 cursor 文件失败: {e}")
        sys.exit(1)

def get_last_event_id(cursor_file):
    """获取上次处理的事件 ID"""
    try:
        if os.path.exists(cursor_file):
            with open(cursor_file, 'r') as f:
                content = f.read().strip()
                return int(content) if content else 0
    except Exception as e:
        logger.warning(f"读取 cursor 文件失败: {e}")
    return 0

def save_last_event_id(cursor_file, event_id):
    """保存上次处理的事件 ID"""
    try:
        with open(cursor_file, 'w') as f:
            f.write(str(event_id))
    except Exception as e:
        logger.error(f"保存 cursor 文件失败: {e}")

def get_last_nginx_offset(offset_file):
    """获取上次读取 nginx 日志的偏移量"""
    try:
        if os.path.exists(offset_file):
            with open(offset_file, 'r') as f:
                content = f.read().strip()
                return int(content) if content else 0
    except Exception as e:
        logger.warning(f"读取 nginx offset 文件失败: {e}")
    return 0

def save_last_nginx_offset(offset_file, offset):
    """保存上次读取 nginx 日志的偏移量"""
    try:
        with open(offset_file, 'w') as f:
            f.write(str(offset))
    except Exception as e:
        logger.error(f"保存 nginx offset 文件失败: {e}")

def send_telegram_message(text, retry_count=0):
    """发送 Telegram 消息(带重试机制)"""
    import requests

    if retry_count >= MAX_RETRIES:
        logger.error(f"Telegram 发送失败,达到最大重试次数")
        return False

    try:
        url = f"https://api.telegram.org/bot{TELEGRAM_BOT_TOKEN}/sendMessage"
        data = {
            "chat_id": TELEGRAM_CHAT_ID,
            "text": text,
            "parse_mode": "HTML"
        }
        proxies = {"https": "http://127.0.0.1:7890"}
        resp = requests.post(url, json=data, proxies=proxies, timeout=10)

        if resp.status_code == 200:
            return True
        else:
            logger.error(f"Telegram 发送失败: HTTP {resp.status_code}")
            time.sleep(RETRY_DELAY)
            return send_telegram_message(text, retry_count + 1)

    except requests.exceptions.Timeout:
        logger.warning(f"Telegram 请求超时,重试 {retry_count + 1}/{MAX_RETRIES}")
        time.sleep(RETRY_DELAY)
        return send_telegram_message(text, retry_count + 1)

    except Exception as e:
        logger.error(f"Telegram 发送错误: {e}")
        return False

def format_event_message(event):
    """格式化数据库事件消息"""
    try:
        event_id = event[0]
        service_id = event[1]
        uid = event[2]
        uname = event[3]
        logtime = event[4]
        loglevel = event[5]
        event_type = event[6]
        parameters = event[7]
        category = event[8]

        # 转换时间戳(数据库存的是 Unix 时间戳,直接转本地时间)
        dt = datetime.fromtimestamp(logtime)
        time_str = dt.strftime('%Y-%m-%d %H:%M:%S')

        # 获取事件名称
        event_name = EVENT_NAME_MAP.get(event_type, f"📌 {event_type}")

        # 解析参数
        try:
            params = json.loads(parameters) if parameters else {}
        except:
            params = {}

        # 构建消息
        message = f"<b>飞牛NAS · {event_name}</b>\n"
        message += f"⏰ {time_str}\n"
        if uname:
            message += f"👤 {uname}\n"
        if params:
            # 只显示关键参数
            for key, value in params.items():
                if key in ['ip', 'IP', 'app', 'disk', 'usage', 'temp']:
                    message += f"📊 {key}: {value}\n"

        return message

    except Exception as e:
        logger.error(f"格式化事件消息失败: {e}")
        return f"<b>飞牛NAS · 事件解析错误</b>\n错误详情已记录到日志"

def format_nginx_message(log_line, match_info):
    """格式化 nginx 日志事件消息"""
    try:
        # 解析 nginx 日志行
        # 格式: IP - - [时间] "请求" 状态 大小 "-" "UA"
        ip_match = re.match(r'^([\d.:a-fA-F]+)', log_line)
        ip = ip_match.group(1) if ip_match else "未知"

        time_match = re.search(r'\[([^\]]+)\]', log_line)
        req_time_raw = time_match.group(1) if time_match else "未知"
        # 转换 nginx 时间格式 -> 北京时间
        try:
            # nginx 格式: 14/May/2026:16:41:31 +0800
            dt = datetime.strptime(req_time_raw, "%d/%b/%Y:%H:%M:%S %z")
            dt_cst = dt.astimezone(timezone(timedelta(hours=8)))
            req_time = dt_cst.strftime('%Y-%m-%d %H:%M:%S')
        except:
            req_time = req_time_raw

        req_match = re.search(r'"([^"]+)"', log_line)
        request = req_match.group(1) if req_match else "未知"

        status_match = re.search(r'" (\d{3}) ', log_line)
        status = status_match.group(1) if status_match else "未知"

        ua_match = re.search(r'"([^"]*)"$', log_line)
        ua = ua_match.group(1) if ua_match else ""

        event_name = match_info["name"]

        # 判断设备类型
        device = "📱 手机 App" if "com.trim.app" in ua else "💻 Web"

        message = f"<b>飞牛NAS · {event_name}</b>\n"
        message += f"⏰ {req_time}\n"
        message += f"🌐 IP: {ip}\n"
        message += f"📱 设备: {device}\n"

        return message

    except Exception as e:
        logger.error(f"格式化 nginx 消息失败: {e}")
        return f"<b>飞牛NAS · 登录事件解析错误</b>"

def check_database(cursor_file, last_event_id):
    """检查数据库新事件"""
    try:
        if not os.path.exists(DB_PATH):
            logger.warning(f"数据库文件不存在: {DB_PATH}")
            return last_event_id

        conn = sqlite3.connect(DB_PATH, timeout=5)
        cursor = conn.cursor()

        cursor.execute("SELECT name FROM sqlite_master WHERE type='table' AND name='log'")
        if not cursor.fetchone():
            logger.error("数据库表 'log' 不存在")
            conn.close()
            return last_event_id

        cursor.execute("""
            SELECT id, serviceId, uid, uname, logtime, loglevel, eventId, parameter, category
            FROM log
            WHERE id > ?
            ORDER BY id ASC
            LIMIT 100
        """, (last_event_id,))

        events = cursor.fetchall()
        conn.close()

        if events:
            logger.info(f"数据库: 找到 {len(events)} 个新事件")

            for event in events:
                event_id = event[0]
                message = format_event_message(event)

                if send_telegram_message(message):
                    logger.info(f"✅ 已发送数据库事件 {event_id}")
                    last_event_id = event_id
                    save_last_event_id(cursor_file, event_id)
                else:
                    logger.error(f"❌ 发送数据库事件 {event_id} 失败")
                    last_event_id = event_id
                    save_last_event_id(cursor_file, event_id)

                time.sleep(0.5)

        return last_event_id

    except Exception as e:
        logger.error(f"数据库查询失败: {e}")
        return last_event_id

def check_nginx_log(offset_file, last_offset):
    """检查 nginx 访问日志"""
    try:
        if not os.path.exists(NGINX_LOG):
            logger.debug(f"nginx 日志文件不存在: {NGINX_LOG}")
            return last_offset

        # 获取当前文件大小
        current_size = os.path.getsize(NGINX_LOG)

        # 如果文件被截断或重新生成,从头开始
        if current_size < last_offset:
            logger.info("nginx 日志被截断,从头读取")
            last_offset = 0

        # 没有新内容
        if current_size == last_offset:
            return last_offset

        with open(NGINX_LOG, 'r') as f:
            f.seek(last_offset)
            new_lines = f.readlines()
            new_offset = f.tell()

        if not new_lines:
            return new_offset

        logger.info(f"nginx: 读取 {len(new_lines)} 行新日志")

        for line in new_lines:
            line = line.strip()
            if not line:
                continue

            # 检查是否匹配监控模式
            for monitor in NGINX_MONITOR_PATTERNS:
                if re.search(monitor["pattern"], line):
                    # 如果有 UA 过滤,检查 UA
                    if monitor.get("ua_pattern"):
                        if not re.search(monitor["ua_pattern"], line):
                            continue

                    message = format_nginx_message(line, monitor)

                    if send_telegram_message(message):
                        logger.info(f"✅ 已发送 nginx 事件: {monitor['name']}")
                    else:
                        logger.error(f"❌ 发送 nginx 事件失败")

                    time.sleep(0.5)
                    break  # 一行只匹配一个模式

        save_last_nginx_offset(offset_file, new_offset)
        return new_offset

    except Exception as e:
        logger.error(f"nginx 日志检查失败: {e}")
        traceback.print_exc()
        return last_offset

def main():
    """主函数"""
    logger.info("🚀 飞牛 NAS 事件监听器启动(稳定版)")
    logger.info(f"数据库: {DB_PATH}")
    logger.info(f"nginx 日志: {NGINX_LOG}")
    logger.info(f"Telegram Bot: @xiaozht_bot")
    logger.info(f"Telegram Chat ID: {TELEGRAM_CHAT_ID}")
    logger.info(f"检查间隔: {SLEEP_INTERVAL} 秒")

    cursor_file, offset_file = init_cursor()
    last_event_id = get_last_event_id(cursor_file)
    last_nginx_offset = get_last_nginx_offset(offset_file)
    logger.info(f"初始 cursor: {last_event_id}, nginx offset: {last_nginx_offset}")

    # 初始化 SSH journal cursor
    last_ssh_cursor = init_ssh_cursor()
    
    # 测试 Telegram 连接
    logger.info("测试 Telegram 连接...")
    if send_telegram_message("🚀 飞牛 NAS 监控启动（数据库 + nginx 日志 + SSH）"):
        logger.info("✅ Telegram 连接正常")
    else:
        logger.warning("❌ Telegram 连接失败，将重试")

    # 主循环
    consecutive_errors = 0
    while True:
        try:
            # 检查数据库事件
            last_event_id = check_database(cursor_file, last_event_id)
            
            # 检查 nginx 日志
            last_nginx_offset = check_nginx_log(offset_file, last_nginx_offset)
            
            # 检查 SSH 登录（journal）
            last_ssh_cursor = check_ssh_log(last_ssh_cursor)
            
            consecutive_errors = 0
        
        except Exception as e:
            consecutive_errors += 1
            logger.error(f"主循环错误 (连续 {consecutive_errors} 次): {e}")
            traceback.print_exc()
            
            if consecutive_errors > 10:
                logger.critical("连续错误超过 10 次，等待 60 秒后重试")
                time.sleep(60)
                consecutive_errors = 0
        
        time.sleep(SLEEP_INTERVAL)

if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        logger.info("收到退出信号,正常退出")
        sys.exit(0)
    except Exception as e:
        logger.critical(f"致命错误: {e}")
        traceback.print_exc()
        sys.exit(1)
